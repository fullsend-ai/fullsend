# Containerfile — base sandbox image for fullsend agent execution.
#
# Pre-installs all runtime dependencies needed by any fullsend agent:
#   - Claude Code (npm, version-pinned via CLAUDE_CODE_VERSION ARG)
#   - pi (npm, version-pinned via PI_VERSION ARG; opt-in runtime, see
#     #6464) + the pi-anthropic-vertex extension
#     (tag + SHA256 pinned under /opt/pi-extensions)
#   - jq (JSON parsing in agent scripts and skills)
#   - gitleaks (secret scanner, SHA256-verified)
#   - acli (Atlassian CLI for Jira issue queries)
#   - pre-commit + gitlint (repo hook runner + commit message validator)
#   - tirith (Rust CLI for terminal security scanning hooks)
#   - ONNX Runtime + ProtectAI DeBERTa-v3 model for prompt injection
#     detection (loaded natively by fullsend via Go/hugot — no Python
#     runtime dependency, no cold-start latency)
#
# Must extend the OpenShell base image — the sandbox supervisor is
# side-loaded at runtime.
#
# Build:
#   podman build -t <registry>/fullsend-sandbox:v1 \
#     -f images/sandbox/Containerfile images/sandbox/
#
# Per-org images that need extra tools (e.g. Go, Rust) should extend
# this base:
#   FROM <registry>/fullsend-sandbox:v1
#   RUN apt-get install -y golang

FROM ghcr.io/nvidia/openshell-community/sandboxes/base@sha256:aeef1c63f00e2913ea002ccb3aaf925f338b5c5d70e63576f0d95c16a138044e

# The base image runs as the sandbox user (998). Switch to root for
# package installation and switch back at the end.
USER root

# BuildKit automatic platform ARG — set by --platform during multi-arch builds.
ARG TARGETARCH

# ---------------------------------------------------------------------------
# Install jq (JSON parsing in agent scripts and skills).
RUN apt-get update \
    && apt-get install -y --no-install-recommends jq \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Install Claude Code — pinned version for supply chain safety.
# npm is provided by the OpenShell base image (Node.js pre-installed).
# The official curl|bash installer installs the latest version with no
# pinning, so Docker layer caching silently locks in whatever version
# was current at build time.  When the cache busts, the next build
# picks up a new version with no review.  Using npm with an explicit
# version makes upgrades visible in renovate PRs and CI.
#
# To update: bump CLAUDE_CODE_VERSION; renovate tracks this ARG via
# a customManagers regex entry in renovate.json.
ARG CLAUDE_CODE_VERSION=2.1.234
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

# ---------------------------------------------------------------------------
# Install pi (earendil-works/pi) — pinned version, same supply-chain rationale
# as Claude Code above. --ignore-scripts is the upstream-recommended install
# (the package ships an npm-shrinkwrap.json; no postinstall needed). Stub
# runtime for now — see #6464; the runtime is not user-selectable until
# implemented, but the binary ships now so the Bootstrap/Run work and any
# in-sandbox fixture capture run against a pinned, reviewed version
# (internal/runtime/testdata/pi/regen.sh reads the pin from this file).
#
# To update: bump PI_VERSION; renovate tracks this ARG via a customManagers
# regex entry in renovate.json. pi releases ~weekly minors and has changed
# its --mode json wire shape within a minor before (0.84.0) — the pi stream
# parser fixtures must be re-verified when this pin moves.
ARG PI_VERSION=0.84.2
RUN node -e "process.exit(process.versions.node.split('.').map(Number).reduce((a,b,i)=>a!==0?a:(b-[22,19,0][i]),0)>=0?0:1)" \
        || (echo "pi ${PI_VERSION} requires Node >=22.19.0, base image has $(node --version)" >&2 && exit 1) \
    && npm install -g --ignore-scripts @earendil-works/pi-coding-agent@${PI_VERSION}

# pi is present in every sandbox regardless of runtime selection (PiRuntime
# is a stub, not yet reachable via config — see internal/runtime/pi.go), so
# an agent invoking the `pi` binary ad-hoc via Bash would otherwise get none
# of PiRuntime.EnvExports()'s defaults. Bake them at image level too. These
# are hygiene defaults (no startup network traffic, runner-owned paths), not
# a security boundary — a process can override its own environment; the
# sandbox egress policy and credential placeholders are the boundary.
# PI_CODING_AGENT_DIR must match sandbox.SandboxPiConfig
# (internal/sandbox/sandbox.go; guarded by TestSandboxImagePiDefaults).
ENV PI_CODING_AGENT_DIR="/sandbox/pi-config" \
    PI_CODING_AGENT_SESSION_DIR="/sandbox/pi-config/sessions" \
    PI_OFFLINE="1" \
    PI_SKIP_VERSION_CHECK="1" \
    PI_TELEMETRY="0"

# ---------------------------------------------------------------------------
# pi-anthropic-vertex — interim Claude-on-Vertex provider for pi
# (github.com/twoGiants/pi-anthropic-vertex, MIT; a ~300-line entry point
# plus ~220 lines mirrored from pi's streamSimple helpers: registers an
# "anthropic-vertex" provider that delegates streaming to pi's built-in
# Anthropic provider through an AnthropicVertex client). pi's own
# google-vertex provider is Gemini-only and the upstream anthropic-vertex
# provider (earendil-works/pi#5262) is still open; swap to it once it ships
# in a pinned pi release. Reviewed at v0.1.13 (#6464).
#
# Pinned by git tag + SHA256 of the GitHub tag tarball (tag v0.1.13 is commit
# d3c9d10d). Installed under PI_EXTENSIONS_DIR (sandbox.SandboxPiExtensionsDir),
# root-owned and outside PI_CODING_AGENT_DIR, so pi never auto-loads it —
# PiRuntime.Run passes it explicitly with -e. Dependencies come from the
# vendored package-lock.json: --omit=peer mirrors pi's own package installer,
# because the extension's peer deps are pi itself, which the extension loader
# resolves to the running pi through module aliases (a local copy would be
# the wrong version); --ignore-scripts as for the pi install above (no
# install scripts in the pruned tree).
#
# To update (also re-run on every PI_VERSION bump): pick a tag from
# https://github.com/twoGiants/pi-anthropic-vertex/tags, check its pi
# compatibility (sync/compat.json upstream; v0.1.13 was synced against pi
# 0.81.1 and its mirrored thinking/max-tokens mapping can lag the pinned
# PI_VERSION), confirm the extension's package.json "overrides" pin of
# @anthropic-ai/sdk matches the version in pi's packages/ai/package.json
# (the Vertex client is cast to pi's Anthropic client type), then set
# PI_ANTHROPIC_VERTEX_VERSION and refresh PI_ANTHROPIC_VERTEX_SHA256 from
#   sha256sum <(curl -fsSL https://github.com/twoGiants/pi-anthropic-vertex/archive/refs/tags/v<ver>.tar.gz)
ARG PI_ANTHROPIC_VERTEX_VERSION=0.1.13
ARG PI_ANTHROPIC_VERTEX_SHA256=6b465c374734b0ae98e7c48d58f935bcfb12760c509475df2c82785a463c7249
ARG PI_EXTENSIONS_DIR=/opt/pi-extensions
RUN curl -fsSL --retry 3 --retry-delay 5 \
      "https://github.com/twoGiants/pi-anthropic-vertex/archive/refs/tags/v${PI_ANTHROPIC_VERTEX_VERSION}.tar.gz" \
      -o /tmp/pi-anthropic-vertex.tar.gz \
    && echo "${PI_ANTHROPIC_VERTEX_SHA256}  /tmp/pi-anthropic-vertex.tar.gz" | sha256sum -c - \
    && mkdir -p "${PI_EXTENSIONS_DIR}/anthropic-vertex" \
    && tar xzf /tmp/pi-anthropic-vertex.tar.gz -C "${PI_EXTENSIONS_DIR}/anthropic-vertex" --strip-components=1 \
    && rm /tmp/pi-anthropic-vertex.tar.gz \
    && cd "${PI_EXTENSIONS_DIR}/anthropic-vertex" \
    && rm -rf .github .pi .vscode sync PLAN.md AGENTS.md \
    && npm ci --omit=dev --omit=peer --ignore-scripts --no-audit --no-fund \
    && find node_modules -type d -empty -delete \
    && npm cache clean --force \
    && chmod -R a+rX,a-w "${PI_EXTENSIONS_DIR}"

# ---------------------------------------------------------------------------
# ONNX Runtime + ProtectAI DeBERTa-v3 model for ML-based prompt injection
# scanning. The fullsend binary loads the model directly via Go (hugot +
# onnxruntime) — no Python, no cold-start latency.
#
# Download ProtectAI DeBERTa-v3 ONNX model files directly via curl.
# The model is loaded at runtime by Go/onnxruntime — no Python dependency.
ARG PROTECTAI_MODEL_REV=e6535ca4ce3ba852083e75ec585d7c8aeb4be4c5
ARG PROTECTAI_MODEL_DIR=/opt/fullsend/models/protectai-deberta-v3/onnx
ARG PROTECTAI_MODEL_ONNX_SHA256=f0ea7f239f765aedbde7c9e163a7cb38a79c5b8853d3f76db5152172047b228c
ARG PROTECTAI_CONFIG_SHA256=3093743035223c46b1497a72e939e56fa0a50afbd7bafbf7eb8aad060b8d23f8
ARG PROTECTAI_TOKENIZER_SHA256=752fe5f0d5678ad563e1bd2ecc1ddf7a3ba7e2024d0ac1dba1a72975e26dff2f
ARG PROTECTAI_SPECIAL_TOKENS_SHA256=b2f1b2f15f29a6b6d9d6ea4eca1675d2c231a71477f151d48f79cc83a625ba21
ARG PROTECTAI_TOKENIZER_CONFIG_SHA256=77d3dd1a9c30397a06545251ed9274bd92e4a85feb98497eeed50c920f962274
RUN mkdir -p "${PROTECTAI_MODEL_DIR}" \
    && for f in model.onnx config.json tokenizer.json special_tokens_map.json tokenizer_config.json; do \
         curl -fsSL --retry 3 --retry-delay 5 \
           "https://huggingface.co/protectai/deberta-v3-base-prompt-injection-v2/resolve/${PROTECTAI_MODEL_REV}/onnx/${f}" \
           -o "${PROTECTAI_MODEL_DIR}/${f}"; \
       done \
    && echo "${PROTECTAI_MODEL_ONNX_SHA256}  ${PROTECTAI_MODEL_DIR}/model.onnx" | sha256sum -c - \
    && echo "${PROTECTAI_CONFIG_SHA256}  ${PROTECTAI_MODEL_DIR}/config.json" | sha256sum -c - \
    && echo "${PROTECTAI_TOKENIZER_SHA256}  ${PROTECTAI_MODEL_DIR}/tokenizer.json" | sha256sum -c - \
    && echo "${PROTECTAI_SPECIAL_TOKENS_SHA256}  ${PROTECTAI_MODEL_DIR}/special_tokens_map.json" | sha256sum -c - \
    && echo "${PROTECTAI_TOKENIZER_CONFIG_SHA256}  ${PROTECTAI_MODEL_DIR}/tokenizer_config.json" | sha256sum -c - \
    && echo "ProtectAI DeBERTa-v3 model downloaded at rev ${PROTECTAI_MODEL_REV} (all files SHA256-verified)"

# ---------------------------------------------------------------------------
# ONNX Runtime shared library — loaded by hugot at runtime.
# Pinned version for supply chain safety.
# To update: bump ORT_VERSION and ORT_SHA256_{AMD64,ARM64} from:
#   https://github.com/microsoft/onnxruntime/releases
ARG ORT_VERSION=1.24.1
ARG ORT_SHA256_AMD64=9142552248b735920f9390027e4512a2cacf8946a1ffcbe9071a5c210531026f
ARG ORT_SHA256_ARM64=0f56edd68f7602df790b68b874a46b115add037e88385c6c842bb763b39b9f89
RUN case "$TARGETARCH" in \
      amd64) ORT_ARCH="x64";     ORT_SHA="$ORT_SHA256_AMD64" ;; \
      arm64) ORT_ARCH="aarch64"; ORT_SHA="$ORT_SHA256_ARM64" ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl -fsSL \
      "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-${ORT_ARCH}-${ORT_VERSION}.tgz" \
      -o /tmp/ort.tgz \
    && echo "${ORT_SHA}  /tmp/ort.tgz" | sha256sum -c - \
    && tar xzf /tmp/ort.tgz -C /tmp/ \
    && cp "/tmp/onnxruntime-linux-${ORT_ARCH}-${ORT_VERSION}/lib/libonnxruntime.so.${ORT_VERSION}" /usr/lib/ \
    && ln -sf "/usr/lib/libonnxruntime.so.${ORT_VERSION}" /usr/lib/libonnxruntime.so \
    && /sbin/ldconfig \
    && rm -rf /tmp/ort.tgz "/tmp/onnxruntime-linux-${ORT_ARCH}-${ORT_VERSION}"

# ---------------------------------------------------------------------------
# gitleaks — secret scanner used by scan-secrets and post-scripts.
# Pinned version + SHA256 checksum for supply chain safety.
# To update: bump GITLEAKS_VERSION and GITLEAKS_SHA256_{AMD64,ARM64} from:
#   https://github.com/gitleaks/gitleaks/releases/download/v<VERSION>/gitleaks_<VERSION>_checksums.txt
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_SHA256_AMD64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ARG GITLEAKS_SHA256_ARM64=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
RUN case "$TARGETARCH" in \
      amd64) GL_ARCH="x64";   GL_SHA="$GITLEAKS_SHA256_AMD64" ;; \
      arm64) GL_ARCH="arm64"; GL_SHA="$GITLEAKS_SHA256_ARM64" ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl -fsSL \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GL_ARCH}.tar.gz" \
      -o /tmp/gitleaks.tar.gz \
    && echo "${GL_SHA}  /tmp/gitleaks.tar.gz" | sha256sum -c - \
    && tar xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && chmod +x /usr/local/bin/gitleaks \
    && rm /tmp/gitleaks.tar.gz

# ---------------------------------------------------------------------------
# pre-commit + gitlint — pre-commit runs repo-defined hooks (formatting,
# linting, etc.) on changed files. gitlint validates commit message format.
# Baking them in avoids pip installs on every run and ensures availability
# even if pip is network-restricted inside the sandbox.
ARG PRECOMMIT_VERSION=4.5.1
ARG GITLINT_VERSION=0.19.1
ARG JSONSCHEMA_VERSION=4.23.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --break-system-packages \
      "pre-commit==${PRECOMMIT_VERSION}" \
      "gitlint-core==${GITLINT_VERSION}" \
      "jsonschema==${JSONSCHEMA_VERSION}"

# ---------------------------------------------------------------------------
# tirith — terminal security scanner for PreToolUse hooks.
# Pinned version + sha256 checksum for supply chain safety.
# Renovate bumps TIRITH_VERSION; postUpgradeTasks runs
# scripts/renovate/update-tirith-checksums.sh to refresh the SHA256 ARGs.
ARG TIRITH_VERSION=0.3.1
ARG TIRITH_SHA256_AMD64=571e6a300e4c444293476537a322666069e561c7f05283d6650f5b8ef83db3ac
ARG TIRITH_SHA256_ARM64=0462fe5083b4c72c45a8de918d5413e21d17aa8077aa7dbe53c0876b112847bb
RUN case "$TARGETARCH" in \
      amd64) TI_ARCH="x86_64";  TI_SHA="$TIRITH_SHA256_AMD64" ;; \
      arm64) TI_ARCH="aarch64"; TI_SHA="$TIRITH_SHA256_ARM64" ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/sheeki03/tirith/releases/download/v${TIRITH_VERSION}/tirith-${TI_ARCH}-unknown-linux-gnu.tar.gz" \
      -o /tmp/tirith.tar.gz \
    && echo "${TI_SHA}  /tmp/tirith.tar.gz" | sha256sum -c - \
    && tar xzf /tmp/tirith.tar.gz -C /usr/local/bin tirith \
    && chmod +x /usr/local/bin/tirith \
    && rm /tmp/tirith.tar.gz

# ---------------------------------------------------------------------------
# Workaround for NVIDIA/OpenShell#886: the sandbox proxy does TLS
# termination and re-signs traffic with its own CA at
# /etc/openshell-tls/ca-bundle.pem, but does not auto-configure
# git/curl/pip to trust it. Set the env vars at image level so
# every tool picks up the proxy CA without per-agent env files.
# Remove after upstream fixes CA propagation.
#
# The CA bundle path only exists at runtime (injected by OpenShell).
# To avoid breaking curl/pip during builds of child images that inherit
# these ENV vars, we create a symlink to the system CA bundle. At
# runtime, OpenShell overwrites the file with the real proxy CA.
RUN mkdir -p /etc/openshell-tls \
    && ln -sf /etc/ssl/certs/ca-certificates.crt /etc/openshell-tls/ca-bundle.pem
ENV GIT_SSL_CAINFO="/etc/openshell-tls/ca-bundle.pem" \
    SSL_CERT_FILE="/etc/openshell-tls/ca-bundle.pem" \
    REQUESTS_CA_BUNDLE="/etc/openshell-tls/ca-bundle.pem" \
    CURL_CA_BUNDLE="/etc/openshell-tls/ca-bundle.pem" \
    NODE_EXTRA_CA_CERTS="/etc/openshell-tls/ca-bundle.pem" \
    HF_HUB_OFFLINE="1"

# ---------------------------------------------------------------------------
# acli — Atlassian CLI for Jira issue retrieval inside agent sandboxes.
ARG ACLI_VERSION=1.3.18-stable
ARG ACLI_SHA256_AMD64=4ad4badc481ac1eff452f531c405a20422eb57513cc898d2a1f8ea945d6c24f6
ARG ACLI_SHA256_ARM64=ac71711da43649854689ad0f74e44f18b0da3fd0ee776ceb4307ae7eb1e5da85
RUN case "$TARGETARCH" in \
      amd64) ACLI_SHA="$ACLI_SHA256_AMD64" ;; \
      arm64) ACLI_SHA="$ACLI_SHA256_ARM64" ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl -fsSL \
      "https://acli.atlassian.com/linux/${ACLI_VERSION}/acli_${ACLI_VERSION}_linux_${TARGETARCH}.tar.gz" \
      -o /tmp/acli.tar.gz \
    && echo "${ACLI_SHA}  /tmp/acli.tar.gz" | sha256sum -c - \
    && tar xzf /tmp/acli.tar.gz -C /tmp \
    && mv "/tmp/acli_${ACLI_VERSION}_linux_${TARGETARCH}/acli" /usr/local/bin/acli \
    && chmod +x /usr/local/bin/acli \
    && rm -rf /tmp/acli.tar.gz /tmp/acli_${ACLI_VERSION}_linux_${TARGETARCH}

# Switch back to the sandbox user.
USER sandbox
