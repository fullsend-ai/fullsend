{
  "name": "fullsend-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:worker": "wrangler dev --config cloudflare_site/wrangler.toml --port 8787 --ip 127.0.0.1",
    "test": "vitest run --config vite.config.ts && vitest run --config cloudflare_site/worker/vitest.config.mts",
    "format": "prettier --write 'docs/.vitepress/**/*.{vue,ts,js,css}'",
    "format:check": "prettier --check 'docs/.vitepress/**/*.{vue,ts,js,css}'",
    "stylelint": "stylelint 'docs/.vitepress/**/*.{vue,css}'",
    "stylelint:fix": "stylelint 'docs/.vitepress/**/*.{vue,css}' --fix",
    "docs:dev": "git submodule update --init && vitepress dev docs",
    "docs:build": "git submodule update --init && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.4.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.10.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.110.0",
    "@vueuse/core": "^12.4.0",
    "@vueuse/integrations": "^12.4.0",
    "mark.js": "8.11.1",
    "mermaid": "~11.17.0",
    "minisearch": "^7.1.1",
    "vitepress": "1.6.4",
    "vue": "^3.5.14"
  },
  "lint-staged": {
    "docs/.vitepress/**/*.{ts,js}": [
      "prettier --write"
    ],
    "docs/.vitepress/**/*.vue": [
      "stylelint --fix",
      "prettier --write"
    ],
    "docs/.vitepress/**/*.css": [
      "stylelint --fix",
      "prettier --write"
    ]
  }
}
