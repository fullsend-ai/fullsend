#!/usr/bin/env bash
# post-__AGENT_NAME__.sh — turn the __AGENT_NAME__ agent's JSON result into one comment.
#
# Generated by `fullsend agent new`. Safe to edit.
#
# Runs on the trusted runner after the sandbox exits. The working directory is
# the RUN directory, and the agent's output lives one level down, in
# iteration-<N>/output/agent-result.json — fullsend runs the agent once per
# iteration and only the last one counts.
#
# Required env:
#   ISSUE_URL — HTML URL of the work item (the harness maps GITHUB_ISSUE_URL to it)
#   GH_TOKEN  — minted by fullsend from the harness `role:` field
#
# Optional env:
#   FULLSEND_VALIDATED_ITERATION_DIR — set by fullsend when a validation_loop
#     is configured and an iteration passed it. When present it names the
#     iteration whose output was validated, which is not necessarily the last
#     one, so it wins over the scan below.
#
# Treat the result file as untrusted: it is model output. Only the three
# fields below are ever read, each is required to be a string, and the
# comment body is piped on stdin rather than interpolated into a command.

set -euo pipefail

# ${#var} and ${var:0:n} count characters in a UTF-8 locale and BYTES under
# C/POSIX. The result schema's maxLength counts Unicode code points, so
# without this a valid multibyte summary is rejected as too long and
# truncation can slice mid-character.
export LC_ALL="${LC_ALL:-C.UTF-8}"

: "${ISSUE_URL:?ISSUE_URL must be set}"
: "${GH_TOKEN:?GH_TOKEN must be set}"

MARKER="<!-- fullsend:__AGENT_NAME__-agent -->"
MAX_SUMMARY_CHARS=200
MAX_COMMENT_CHARS=16384

# Locate the result. FULLSEND_VALIDATED_ITERATION_DIR is set by fullsend on
# the runner, not by the sandbox or the agent, so it is trusted as given.
RESULT_FILE=""
if [[ -n "${FULLSEND_VALIDATED_ITERATION_DIR:-}" ]]; then
  if [[ -f "${FULLSEND_VALIDATED_ITERATION_DIR}/agent-result.json" ]]; then
    RESULT_FILE="${FULLSEND_VALIDATED_ITERATION_DIR}/agent-result.json"
  else
    echo "post-__AGENT_NAME__: FULLSEND_VALIDATED_ITERATION_DIR is set but has no agent-result.json" >&2
    exit 1
  fi
else
  # No validation loop configured: take the HIGHEST-numbered iteration that
  # produced output. Compared numerically, not by glob order — the glob sorts
  # lexicographically, which puts iteration-10 before iteration-9.
  _best=-1
  for _dir in iteration-*/output; do
    [[ -f "${_dir}/agent-result.json" ]] || continue
    _n="${_dir%/output}"
    _n="${_n#iteration-}"
    [[ "${_n}" =~ ^[0-9]+$ ]] || continue
    if (( _n > _best )); then
      _best="${_n}"
      RESULT_FILE="${_dir}/agent-result.json"
    fi
  done
fi

if [[ -z "${RESULT_FILE}" || ! -f "${RESULT_FILE}" ]]; then
  echo "post-__AGENT_NAME__: no agent-result.json found in any iteration-*/output directory" >&2
  exit 1
fi
if ! jq -e 'type == "object"' "${RESULT_FILE}" >/dev/null 2>&1; then
  echo "post-__AGENT_NAME__: ${RESULT_FILE} is not a JSON object" >&2
  exit 1
fi

# Field allowlist: anything else in the file is ignored by construction.
status=$(jq -r 'if (.status | type) == "string" then .status else empty end' "${RESULT_FILE}")
summary=$(jq -r 'if (.summary | type) == "string" then .summary else empty end' "${RESULT_FILE}")
comment=$(jq -r 'if (.comment | type) == "string" then .comment else empty end' "${RESULT_FILE}")

case "${status}" in
  ok|findings|error) ;;
  *) echo "post-__AGENT_NAME__: status must be ok, findings or error (got '${status}')" >&2; exit 1 ;;
esac
[[ -n "${summary}" ]] || { echo "post-__AGENT_NAME__: summary is required" >&2; exit 1; }
if [[ "${summary}" == *$'\n'* || "${summary}" == *$'\r'* ]]; then
  echo "post-__AGENT_NAME__: summary must be a single line" >&2
  exit 1
fi
[[ -n "${comment}" ]] || { echo "post-__AGENT_NAME__: comment is required" >&2; exit 1; }
if (( ${#summary} > MAX_SUMMARY_CHARS )); then
  echo "post-__AGENT_NAME__: summary exceeds ${MAX_SUMMARY_CHARS} characters" >&2
  exit 1
fi
# Truncate to MAX_COMMENT_CHARS *including* the marker, so the result never
# exceeds the cap the schema declares.
TRUNCATION_MARKER=$'\n\n_(truncated)_'
if (( ${#comment} > MAX_COMMENT_CHARS )); then
  keep=$(( MAX_COMMENT_CHARS - ${#TRUNCATION_MARKER} ))
  if (( keep < 0 )); then keep=0; fi
  comment="${comment:0:${keep}}${TRUNCATION_MARKER}"
fi

if [[ "${status}" == "ok" ]]; then
  echo "post-__AGENT_NAME__: status=ok, nothing to post" >&2
  exit 0
fi

# Derive the repo and number from the work item URL rather than trusting extra
# environment. The pattern also rejects anything that is not a github.com URL.
url_re='^https://github[.]com/([A-Za-z0-9._-]+/[A-Za-z0-9._-]+)/(issues|pull)/([0-9]+)$'
if [[ ! "${ISSUE_URL}" =~ ${url_re} ]]; then
  echo "post-__AGENT_NAME__: ISSUE_URL is not a GitHub issue or pull request URL" >&2
  exit 1
fi
REPO="${BASH_REMATCH[1]}"
NUMBER="${BASH_REMATCH[3]}"

if [[ "${__DRY_RUN_VAR__:-}" == "1" ]]; then
  printf '**%s**\n\n%s\n' "${summary}" "${comment}"
  echo "post-__AGENT_NAME__: dry run, not posting" >&2
  exit 0
fi

# fullsend issues post-comment is the repo's sticky-comment primitive: it
# finds this agent's previous comment by marker and edits it in place, so
# re-runs do not flood the work item.
printf '**%s**\n\n%s\n' "${summary}" "${comment}" \
  | fullsend issues post-comment \
      --tracker github \
      --project "${REPO}" \
      --number "${NUMBER}" \
      --marker "${MARKER}" \
      --result -
