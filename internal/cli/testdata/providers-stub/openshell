#!/bin/sh
# Fake openshell that passes CheckGateway and handles provider/profile/sandbox
# commands. Used by TestRunAgent tests that exercise the provider/profile
# orchestration block past the gateway check.

case "$1" in
  gateway)
    case "$2" in
      list) echo "default-gateway"; exit 0 ;;
    esac
    ;;
  settings)
    exit 0
    ;;
  provider)
    # Track imported profile ids so list-profiles can satisfy
    # ImportProfileVerified (Forget → import → ProfileExists).
    # TMPDIR is per-test when callers isolate it.
    STATE="${TMPDIR:-/tmp}/fullsend-providers-stub.profiles"
    case "$2" in
      list-profiles)
        printf '['
        first=1
        if [ -f "$STATE" ]; then
          while IFS= read -r id; do
            [ -n "$id" ] || continue
            if [ "$first" -eq 1 ]; then first=0; else printf ','; fi
            printf '{"id":"%s"}' "$id"
          done < "$STATE"
        fi
        printf ']\n'
        exit 0
        ;;
      profile)
        case "$3" in
          delete)
            if [ -n "$4" ] && [ -f "$STATE" ]; then
              grep -v "^$4$" "$STATE" > "$STATE.tmp" || true
              mv "$STATE.tmp" "$STATE"
            fi
            exit 0
            ;;
        esac
        # Validate --file argument has .yaml/.yml extension when present.
        prev=""
        for arg in "$@"; do
          case "$prev" in
            --file)
              case "$arg" in
                *.yaml|*.yml) ;;
                *) echo "openshell stub: --file must end in .yaml or .yml, got: $arg" >&2; exit 1 ;;
              esac
              if [ -f "$arg" ]; then
                id=$(awk '/^id:/{print $2; exit}' "$arg")
                if [ -n "$id" ]; then
                  printf '%s\n' "$id" >> "$STATE"
                fi
              fi
              ;;
          esac
          prev="$arg"
        done
        exit 0
        ;;
      create|update)
        exit 0
        ;;
    esac
    ;;
  sandbox)
    case "$2" in
      create|delete|ready|exec)
        exit 0
        ;;
    esac
    ;;
esac

echo "openshell stub: unhandled: $*" >&2
exit 1
