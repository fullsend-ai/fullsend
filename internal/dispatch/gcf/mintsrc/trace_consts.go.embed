package function

// Tracing settings stamped by `fullsend mint deploy`. The GCF provisioner
// (internal/dispatch/gcf) replaces this file in the deployed source with
// generated values; this copy leaves tracing disabled. Collector header
// values are never stamped: otlpHeadersSecret names the Secret Manager
// secret that holds them, and is empty when the collector takes no
// authentication headers.
var (
	otlpTracesEndpoint string
	traceDeployment    string
	otlpHeadersSecret  string
)
