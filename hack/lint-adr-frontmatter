#!/usr/bin/env python3
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml>=6.0"]
# ///
"""Validate frontmatter in ADR files.

Checks:
- ADR files have required frontmatter fields (title, status)
- Status in frontmatter matches the ## Status section in the body
- Status is a valid value
- relates_to entries reference existing problem docs (or "*")
- topics is a list if present
- [ADR NNNN — Title] reference labels match the target's frontmatter title

Adapted from https://github.com/konflux-ci/architecture/blob/main/hack/lint-frontmatter
"""

import os
import re
import sys

import yaml

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ADR_DIR = os.path.join(REPO_ROOT, "docs", "ADRs")
PROBLEMS_DIR = os.path.join(REPO_ROOT, "docs", "problems")

VALID_STATUSES = {"Accepted", "Deprecated", "Superseded"}

# Canonical References-section form: [ADR NNNN — <frontmatter title minus "N. ">]
ADR_EMDASH_REF_RE = re.compile(r"\[ADR (\d{4}) — ([^\]]+)\]")
TITLE_NUMBER_PREFIX_RE = re.compile(r"^\d+\.\s+")


def expected_ref_title(frontmatter_title):
    """Strip the leading 'N. ' prefix from an ADR frontmatter title."""
    return TITLE_NUMBER_PREFIX_RE.sub("", frontmatter_title.strip(), count=1)


def check_reference_titles(rel_path, content, titles_by_number):
    """Return errors for [ADR NNNN — Title] labels that do not match frontmatter.

    Only the canonical em-dash form is checked. Colon-form, number-only, and
    unlinked references are left alone so existing entries are not retrofitted.
    """
    errors = []
    for match in ADR_EMDASH_REF_RE.finditer(content):
        number, label = match.group(1), match.group(2)
        expected = titles_by_number.get(number)
        if expected is None:
            errors.append(f"{rel_path}: [ADR {number} — {label}] references unknown ADR {number}")
            continue
        if label != expected:
            errors.append(
                f"{rel_path}: [ADR {number} — {label}] title does not match "
                f"frontmatter title {expected!r}"
            )
    return errors


def get_valid_problem_docs():
    """Return set of problem doc names (without .md) that exist on disk."""
    problems = set()
    if not os.path.isdir(PROBLEMS_DIR):
        return problems
    for f in os.listdir(PROBLEMS_DIR):
        if f.endswith(".md"):
            problems.add(f.replace(".md", ""))
    return problems


def parse_frontmatter(filepath):
    """Extract YAML frontmatter from a markdown file. Returns (dict, error)."""
    with open(filepath, encoding="utf-8") as f:
        content = f.read()

    if not content.startswith("---\n"):
        return None, "missing frontmatter"

    end = content.find("\n---\n", 4)
    if end == -1:
        end = content.find("\n---\r\n", 4)
    if end == -1:
        return None, "missing closing frontmatter delimiter"

    fm_text = content[4:end]
    try:
        data = yaml.safe_load(fm_text)
    except yaml.YAMLError as e:
        return None, f"invalid YAML: {e}"

    if not isinstance(data, dict):
        return None, "frontmatter is not a mapping"

    return data, None


def extract_status_from_body(filepath):
    """Extract the first word of the ## Status section from the markdown body."""
    with open(filepath, encoding="utf-8") as f:
        lines = f.readlines()

    in_status = False
    for line in lines:
        stripped = line.strip()
        if stripped == "## Status":
            in_status = True
            continue
        if in_status and stripped.startswith("## "):
            break
        if in_status and stripped:
            clean = re.sub(r"[*_`]", "", stripped)
            return clean.split()[0] if clean.split() else None
    return None


def validate_adr(filepath, valid_problems):
    """Validate an ADR file's frontmatter. Returns list of error strings."""
    errors = []
    rel_path = os.path.relpath(filepath, REPO_ROOT)

    fm, err = parse_frontmatter(filepath)
    if err:
        return [f"{rel_path}: {err}"]

    # Required fields
    for field in ["title", "status"]:
        if field not in fm:
            errors.append(f"{rel_path}: missing required field '{field}'")

    # Status validation
    if "status" in fm:
        if fm["status"] not in VALID_STATUSES:
            errors.append(
                "{}: invalid frontmatter status '{}'. Valid: {}".format(
                    rel_path, fm["status"], ", ".join(sorted(VALID_STATUSES))
                )
            )

        # Check consistency with ## Status section
        body_status = extract_status_from_body(filepath)
        if body_status:
            fm_norm = fm["status"].lower().strip()
            body_norm = body_status.lower().strip()
            if fm_norm != body_norm:
                errors.append(
                    "{}: frontmatter status '{}' does not match ## Status section '{}'".format(
                        rel_path, fm["status"], body_status
                    )
                )

    # relates_to validation
    if "relates_to" in fm:
        if not isinstance(fm["relates_to"], list):
            errors.append(
                "{}: relates_to must be a YAML list, got {}".format(
                    rel_path, type(fm["relates_to"]).__name__
                )
            )
        else:
            for ref in fm["relates_to"]:
                if ref != "*" and ref not in valid_problems:
                    errors.append(
                        f"{rel_path}: relates_to references unknown problem doc '{ref}' "
                        "(expected a filename without .md from docs/problems/)"
                    )

    # topics validation
    if "topics" in fm and not isinstance(fm["topics"], list):
        errors.append(
            "{}: topics must be a YAML list, got {}".format(rel_path, type(fm["topics"]).__name__)
        )

    return errors


def main():
    valid_problems = get_valid_problem_docs()

    print("INFO: Validating ADR frontmatter...")
    print(f"INFO: Found {len(valid_problems)} problem docs for cross-reference validation")
    print()

    adr_files = []
    for f in sorted(os.listdir(ADR_DIR)):
        if re.match(r"^\d{4}-.*\.md$", f) and not f.startswith("0000-"):
            adr_files.append(os.path.join(ADR_DIR, f))

    if not adr_files:
        print("WARNING: No ADR files found in docs/ADRs/")
        return 0

    print("Checking ADR frontmatter...")
    print("=" * 50)

    all_errors = []
    titles_by_number = {}
    for filepath in adr_files:
        filename = os.path.basename(filepath)
        file_errors = validate_adr(filepath, valid_problems)
        if file_errors:
            all_errors.extend(file_errors)
            print(f"  {filename}: FAIL")
        else:
            print(f"  {filename}: OK")

        fm, err = parse_frontmatter(filepath)
        number_match = re.match(r"^(\d{4})-", filename)
        if not err and number_match and isinstance(fm.get("title"), str):
            titles_by_number[number_match.group(1)] = expected_ref_title(fm["title"])

    print("=" * 50)
    print()
    print("Checking ADR reference titles...")
    print("=" * 50)

    for filepath in adr_files:
        filename = os.path.basename(filepath)
        rel_path = os.path.relpath(filepath, REPO_ROOT)
        with open(filepath, encoding="utf-8") as f:
            content = f.read()
        ref_errors = check_reference_titles(rel_path, content, titles_by_number)
        if ref_errors:
            all_errors.extend(ref_errors)
            print(f"  {filename}: FAIL")
        else:
            print(f"  {filename}: OK")

    print("=" * 50)

    if all_errors:
        print(f"ERROR: {len(all_errors)} ADR validation error(s)")
        for e in all_errors:
            print(f"  ERROR: {e}")
        return 1
    else:
        print(f"OK: All {len(adr_files)} ADR files have valid frontmatter and reference titles")
        return 0


if __name__ == "__main__":
    sys.exit(main())
