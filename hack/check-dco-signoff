#!/usr/bin/env bash
# check-dco-signoff — Validate DCO sign-off trailer on human commits
#
# Validates that non-bot commits carry a Signed-off-by trailer matching
# the git author or committer name and email in accordance with the Developer
# Certificate of Origin (DCO).
#
# Skips:
#   - Autonomous bot commits ([bot] in author name/email)
#   - Active merge commits (when MERGE_HEAD is present)
#   - Autosquash commits (subject starting with fixup!, squash!, amend!)
#   - Truly empty / whitespace-only commit messages
#   - When SKIP_DCO=1 or SKIP_COMMIT_MSG_HOOK=1 is set
#
# Usage:
#   hack/check-dco-signoff <commit-msg-file>

set -euo pipefail

COMMIT_MSG_FILE="${1:-}"

if [[ -z "${COMMIT_MSG_FILE}" ]] || [[ ! -f "${COMMIT_MSG_FILE}" ]]; then
  echo "Usage: check-dco-signoff <commit-msg-file>" >&2
  exit 1
fi

# Allow skipping validation via environment variable
if [[ -n "${SKIP_DCO:-}" ]] || [[ -n "${SKIP_COMMIT_MSG_HOOK:-}" ]]; then
  exit 0
fi

# Exit 0 ONLY when the raw file itself has no non-whitespace content.
# If the raw file has non-whitespace content (even if comment-prefixed or scissors),
# do NOT exit 0 here; it must fall through to sign-off validation.
if ! grep -q '[^[:space:]]' "${COMMIT_MSG_FILE}"; then
  exit 0
fi

# Skip during active git merge (MERGE_HEAD is present until commit completes)
if [[ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null || true)" ]]; then
  exit 0
fi

# Read lines into array
lines=()
while IFS= read -r line || [[ -n "${line}" ]]; do
  lines+=("${line}")
done < "${COMMIT_MSG_FILE}"

# Resolve comment prefix (core.commentString in Git 2.45+ takes precedence over core.commentChar)
COMMENT_PREFIX="$(git config core.commentString 2>/dev/null || git config core.commentChar 2>/dev/null || echo '#')"
if [[ "${COMMENT_PREFIX}" == "auto" ]]; then
  candidates=('#' ';' '@' '!' '$' '%' '^' '&' '|' ':')
  num_lines=${#lines[@]}

  for c in "${candidates[@]}"; do
    first_trailing=${num_lines}

    # If there is a scissors line starting with c with comments around it,
    # the trailing block starts at or above that scissors line.
    for (( i = 0; i < num_lines; i++ )); do
      line="${lines[i]}"
      if [[ "${line:0:1}" == "${c}" ]] && [[ "${line:1}" == " ------------------------ >8 ------------------------"* || "${line:1}" == " ------------------------ 8< ------------------------"* ]]; then
        has_c_around=false
        if (( i + 1 < num_lines )) && [[ "${lines[i+1]:0:1}" == "${c}" ]]; then
          has_c_around=true
        elif (( i > 0 )) && [[ "${lines[i-1]:0:1}" == "${c}" ]]; then
          has_c_around=true
        fi
        if ${has_c_around}; then
          first_trailing=${i}
          while (( first_trailing > 0 )); do
            prev="${lines[first_trailing-1]}"
            if [[ -z "${prev//[[:space:]]/}" ]] || [[ "${prev:0:1}" == "${c}" ]]; then
              first_trailing=$((first_trailing - 1))
            else
              break
            fi
          done
          break
        fi
      fi
    done

    # If no scissors block was found, check trailing lines backward from the end
    if (( first_trailing == num_lines )); then
      for (( i = num_lines - 1; i >= 0; i-- )); do
        line="${lines[i]}"
        if [[ -z "${line//[[:space:]]/}" ]]; then
          continue
        fi
        if [[ "${line:0:1}" == "${c}" ]]; then
          first_trailing=${i}
        else
          break
        fi
      done
    fi

    # Check if c starts any line before first_trailing (literal check at column 1)
    has_c_before=false
    for (( i = 0; i < first_trailing; i++ )); do
      line="${lines[i]}"
      if [[ "${line:0:1}" == "${c}" ]]; then
        has_c_before=true
        break
      fi
    done

    if [[ "${has_c_before}" == "false" ]]; then
      COMMENT_PREFIX="${c}"
      break
    fi
  done
  [[ "${COMMENT_PREFIX}" == "auto" ]] && COMMENT_PREFIX="#"
fi

# Function to test whether a scissors marker is an active Git cut line
is_git_scissors() {
  local idx="$1"
  # In git commit -v (or when Git cuts at scissors), the lines following scissors
  # are Git's instructions/diff starting with COMMENT_PREFIX (e.g. "# Do not modify...").
  # If the next non-empty line does NOT start with COMMENT_PREFIX, and a Signed-off-by
  # trailer exists later in the file, treat scissors as user body text (git commit -F).
  local num_lines=${#lines[@]}
  local next_line=""
  local j
  for (( j = idx + 1; j < num_lines; j++ )); do
    if [[ -n "${lines[j]//[[:space:]]/}" ]]; then
      next_line="${lines[j]}"
      break
    fi
  done

  if [[ -n "${next_line}" ]] && [[ "${next_line:0:${#COMMENT_PREFIX}}" != "${COMMENT_PREFIX}" ]]; then
    for (( j = idx + 1; j < num_lines; j++ )); do
      if echo "${lines[j]}" | grep -qi '^[[:space:]]*Signed-off-by:'; then
        return 1
      fi
    done
  fi
  return 0
}

# Strip comment lines by checking the first character literally at column 1.
# Stop reading if Git's scissors marker is reached (commit.verbose=true or cleanup=scissors).
msg_content=""
scissors_marker="${COMMENT_PREFIX} ------------------------ >8 ------------------------"
scissors_marker_alt="${COMMENT_PREFIX} ------------------------ 8< ------------------------"
num_lines=${#lines[@]}

for (( i = 0; i < num_lines; i++ )); do
  line="${lines[i]}"
  # A line is a comment only when it starts with COMMENT_PREFIX at column 1 (indented lines preserved)
  if [[ -n "${COMMENT_PREFIX}" ]] && [[ "${line:0:${#COMMENT_PREFIX}}" == "${COMMENT_PREFIX}" ]]; then
    # Exact scissors marker check at column 1
    if [[ "${line}" == "${scissors_marker}"* ]] || [[ "${line}" == "${scissors_marker_alt}"* ]]; then
      if is_git_scissors "${i}"; then
        break
      fi
    fi
    continue
  fi
  msg_content+="${line}"$'\n'
done

# Non-empty lines after stripping comments/scissors
non_empty=$(printf '%s' "${msg_content}" | grep -v '^[[:space:]]*$' || true)

# Extract first line without pipes to avoid SIGPIPE on large messages
subject=""
if [[ -n "${non_empty}" ]]; then
  IFS= read -r subject <<< "${non_empty}"
fi

# Skip autosquash commits
case "${subject}" in
  fixup!*|squash!*|amend!*)
    exit 0
    ;;
esac

# Determine author and committer names and emails.
# git var formats as "Name <email> timestamp tz".
AUTHOR_IDENT="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)"
AUTHOR=""
if [[ -n "${AUTHOR_IDENT}" ]]; then
  AUTHOR="$(echo "${AUTHOR_IDENT}" | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')"
fi

if [[ -z "${AUTHOR}" ]]; then
  NAME="${GIT_AUTHOR_NAME:-$(git config user.name 2>/dev/null || true)}"
  EMAIL="${GIT_AUTHOR_EMAIL:-$(git config user.email 2>/dev/null || true)}"
  if [[ -n "${NAME}" ]] && [[ -n "${EMAIL}" ]]; then
    AUTHOR="${NAME} <${EMAIL}>"
  fi
fi

COMMITTER_IDENT="$(git var GIT_COMMITTER_IDENT 2>/dev/null || true)"
COMMITTER=""
if [[ -n "${COMMITTER_IDENT}" ]]; then
  COMMITTER="$(echo "${COMMITTER_IDENT}" | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')"
fi

if [[ -z "${COMMITTER}" ]]; then
  CNAME="${GIT_COMMITTER_NAME:-${NAME:-$(git config user.name 2>/dev/null || true)}}"
  CEMAIL="${GIT_COMMITTER_EMAIL:-${EMAIL:-$(git config user.email 2>/dev/null || true)}}"
  if [[ -n "${CNAME}" ]] && [[ -n "${CEMAIL}" ]]; then
    COMMITTER="${CNAME} <${CEMAIL}>"
  fi
fi

# Skip autonomous bot commits (checks AUTHOR only, matching Probot DCO's author.type check)
case "${AUTHOR}" in
  *"[bot]"*|*"[BOT]"*|*"renovate["*|*"dependabot["*)
    exit 0
    ;;
esac

if [[ -z "${AUTHOR}" ]] && [[ -z "${COMMITTER}" ]]; then
  echo "ERROR: Git author/committer identity is not configured." >&2
  echo "Run: git config user.name \"Your Name\" && git config user.email \"your@email.com\"" >&2
  exit 1
fi

# Extract the trailer block from non-comment lines using git interpret-trailers.
# -c trailer.separators=: ensures custom separators do not break DCO trailer parsing.
# --no-divider ensures that '---' horizontal rules in the body do not hide trailers.
trailers=""
if [[ -n "${msg_content}" ]]; then
  trailers=$(printf '%s' "${msg_content}" | git -c trailer.separators=: interpret-trailers --parse --no-divider)
fi

# Extract all Signed-off-by trailer lines (case-insensitive) from trailer block
signoffs=$(echo "${trailers}" | grep -i '^[[:space:]]*Signed-off-by:' || true)

if [[ -z "${signoffs}" ]]; then
  echo "ERROR: Commit message is missing DCO sign-off trailer." >&2
  echo "" >&2
  echo "This repository requires human commits to certify the Developer Certificate of Origin (DCO)." >&2
  echo "Expected trailer matching author or committer:" >&2
  echo "  Signed-off-by: ${AUTHOR}" >&2
  if [[ -n "${COMMITTER}" ]] && [[ "${AUTHOR}" != "${COMMITTER}" ]]; then
    echo "  (or Signed-off-by: ${COMMITTER})" >&2
  fi
  echo "" >&2
  echo "To fix this, commit with '-s':" >&2
  echo "  git commit -s" >&2
  echo "or amend an existing commit:" >&2
  echo "  git commit -s --amend" >&2
  echo "" >&2
  echo "For more details, see:" >&2
  echo "  https://developercertificate.org/" >&2
  echo "  CONTRIBUTING.md#dco-developer-certificate-of-origin" >&2
  exit 1
fi

# Probot DCO matches /^Signed-off-by: (.*) <(.*)>\s*$/gim across the entire message
# and checks name and email case-insensitively against author and committer.
# This hook is deliberately stricter in one aspect: to enforce repository
# Conventional Commit conventions (COMMITS.md), the trailer must appear in the
# trailer block (verified via git interpret-trailers and the final message
# paragraph), rather than in arbitrary body text.
probot_regex='^[Ss][Ii][Gg][Nn][Ee][Dd]-[Oo][Ff][Ff]-[Bb][Yy]: ([^ <][^<]*) <([^>]+)>[[:space:]]*$'

AUTHOR_NAME="${AUTHOR%% <*}"
AUTHOR_EMAIL="${AUTHOR#*<}"
AUTHOR_EMAIL="${AUTHOR_EMAIL%>}"

COMMITTER_NAME="${COMMITTER%% <*}"
COMMITTER_EMAIL="${COMMITTER#*<}"
COMMITTER_EMAIL="${COMMITTER_EMAIL%>}"

a_name_lower=$(echo "${AUTHOR_NAME}" | tr '[:upper:]' '[:lower:]')
c_name_lower=$(echo "${COMMITTER_NAME}" | tr '[:upper:]' '[:lower:]')
a_email_lower=$(echo "${AUTHOR_EMAIL}" | tr '[:upper:]' '[:lower:]')
c_email_lower=$(echo "${COMMITTER_EMAIL}" | tr '[:upper:]' '[:lower:]')

# Extract lines of the last paragraph in msg_content (the trailer block region)
msg_lines=()
while IFS= read -r line || [[ -n "${line}" ]]; do
  msg_lines+=("${line}")
done <<< "${msg_content}"

last_non_empty=-1
for (( i = ${#msg_lines[@]} - 1; i >= 0; i-- )); do
  if [[ -n "${msg_lines[i]//[[:space:]]/}" ]]; then
    last_non_empty=${i}
    break
  fi
done

last_para=()
if (( last_non_empty >= 0 )); then
  first_para_line=0
  for (( i = last_non_empty; i >= 0; i-- )); do
    if [[ -z "${msg_lines[i]//[[:space:]]/}" ]]; then
      first_para_line=$((i + 1))
      break
    fi
  done
  for (( i = first_para_line; i <= last_non_empty; i++ )); do
    last_para+=("${msg_lines[i]}")
  done
fi

matched=false
if (( ${#last_para[@]} > 0 )); then
  for line in "${last_para[@]}"; do
    if [[ "${line}" =~ ${probot_regex} ]]; then
      t_name="${BASH_REMATCH[1]}"
      t_email="${BASH_REMATCH[2]}"
      t_name_lower=$(echo "${t_name}" | tr '[:upper:]' '[:lower:]')
      t_email_lower=$(echo "${t_email}" | tr '[:upper:]' '[:lower:]')

      if [[ -n "${AUTHOR}" ]] && [[ "${t_name_lower}" == "${a_name_lower}" && "${t_email_lower}" == "${a_email_lower}" ]]; then
        matched=true
        break
      fi
      if [[ -n "${COMMITTER}" ]] && [[ "${t_name_lower}" == "${c_name_lower}" && "${t_email_lower}" == "${c_email_lower}" ]]; then
        matched=true
        break
      fi
    fi
  done
fi

if [[ "${matched}" != "true" ]]; then
  echo "ERROR: DCO Signed-off-by trailer does not match git author or committer." >&2
  echo "" >&2
  if [[ "${AUTHOR}" == "${COMMITTER}" ]] || [[ -z "${COMMITTER}" ]]; then
    echo "Git author/committer: ${AUTHOR}" >&2
  else
    echo "Git author:          ${AUTHOR}" >&2
    echo "Git committer:       ${COMMITTER}" >&2
  fi
  echo "Found trailer(s):" >&2
  echo "${signoffs}" >&2
  echo "" >&2
  echo "Expected trailer matching author or committer:" >&2
  echo "  Signed-off-by: ${AUTHOR}" >&2
  if [[ -n "${COMMITTER}" ]] && [[ "${AUTHOR}" != "${COMMITTER}" ]]; then
    echo "  (or Signed-off-by: ${COMMITTER})" >&2
  fi
  echo "" >&2
  echo "To fix this, amend your commit with '-s':" >&2
  echo "  git commit -s --amend" >&2
  echo "" >&2
  echo "For more details, see:" >&2
  echo "  https://developercertificate.org/" >&2
  echo "  CONTRIBUTING.md#dco-developer-certificate-of-origin" >&2
  exit 1
fi

exit 0
