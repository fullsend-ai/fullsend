{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullsend.ai/normative/sandbox-env/v1/harness-env.schema.json",
  "title": "Harness sandbox env contract",
  "description": "Validates the env blocks of a fullsend harness YAML (top-level env and forge.<name>.env) against the sandbox environment-variable contract: an env.sandbox key must be a shell variable name and must not be a name the runner reserves, because the runner drops reserved keys instead of exporting them. Other harness fields are not constrained here. Generated from the runner's code (ADR 0146); see README.md.",
  "type": "object",
  "properties": {
    "env": {
      "$ref": "#/$defs/env_block"
    },
    "forge": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "env": {
            "$ref": "#/$defs/env_block"
          }
        }
      }
    }
  },
  "$defs": {
    "env_block": {
      "type": "object",
      "properties": {
        "sandbox": {
          "$ref": "#/$defs/sandbox_env"
        }
      }
    },
    "sandbox_env": {
      "description": "Variables a harness delivers into the sandbox. The runner owns the reserved names and refuses them here.",
      "type": "object",
      "propertyNames": {
        "allOf": [
          {
            "$ref": "#/$defs/env_name"
          },
          {
            "not": {
              "$ref": "#/$defs/reserved"
            }
          }
        ]
      }
    },
    "env_name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "reserved": {
      "description": "Reserved by the runner: a harness cannot set these through env.sandbox.",
      "enum": [
        "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
        "ACTIONS_ID_TOKEN_REQUEST_URL",
        "ALL_PROXY",
        "BASH_ENV",
        "CDPATH",
        "CURL_CA_BUNDLE",
        "DYLD_INSERT_LIBRARIES",
        "ENV",
        "FULLSEND_FETCH_TOKEN",
        "FULLSEND_FETCH_URL",
        "FULLSEND_GCP_OIDC_AUTH_FILE",
        "FULLSEND_GCP_OIDC_URL",
        "FULLSEND_GCP_PROJECT_ID",
        "FULLSEND_GCP_WIF_PROVIDER",
        "FULLSEND_GITHUB_RUNNER_SECRETS",
        "FULLSEND_GITHUB_RUNNER_SECRETS_FILE",
        "FULLSEND_GITLAB_TRIGGER_ACCOUNT_TOKEN",
        "FULLSEND_INFERENCE_GATEWAY_API_KEY",
        "FULLSEND_ITERATION_DEADLINE",
        "FULLSEND_OPENAI_API_KEY",
        "FULLSEND_OPENAI_AUDIENCE",
        "FULLSEND_OPENAI_IDENTITY_PROVIDER_ID",
        "FULLSEND_OPENAI_SERVICE_ACCOUNT_ID",
        "FULLSEND_OUTPUT_DIR",
        "FULLSEND_OUTPUT_FILE",
        "FULLSEND_OUTPUT_SCHEMA",
        "FULLSEND_PERSONAS_FILE",
        "FULLSEND_ROLE",
        "FULLSEND_RUNNER_PATH",
        "FULLSEND_SLUG",
        "FULLSEND_TARGET_REPO_DIR",
        "FULLSEND_TIMEOUT_MINUTES",
        "FULLSEND_TRIGGER_TOKEN",
        "FULLSEND_WEBHOOK_SECRET",
        "GH_WORKFLOW_TOKEN",
        "GIT_ASKPASS",
        "GIT_CONFIG_GLOBAL",
        "GIT_EXEC_PATH",
        "GIT_SSH_COMMAND",
        "GIT_TEMPLATE_DIR",
        "HOME",
        "HOSTALIASES",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "IFS",
        "JAVA_TOOL_OPTIONS",
        "LD_AUDIT",
        "LD_LIBRARY_PATH",
        "LD_PRELOAD",
        "NODE_EXTRA_CA_CERTS",
        "NODE_OPTIONS",
        "NO_PROXY",
        "OPENAI_API_KEY",
        "PATH",
        "PERL5OPT",
        "PROMPT_COMMAND",
        "PYTHONPATH",
        "PYTHONSTARTUP",
        "RUBYOPT",
        "SHELL",
        "SSL_CERT_DIR",
        "SSL_CERT_FILE",
        "TRACEPARENT"
      ]
    }
  }
}
