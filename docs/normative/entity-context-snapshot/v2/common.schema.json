{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullsend.ai/normative/entity-context-snapshot/v2/common.schema.json",
  "title": "EntityContextSnapshotCommonDefinitions",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "record_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "structural_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:=-]*$",
      "description": "Source or receipt identifier. Structural IDs use a printable, separator-safe ASCII alphabet and are never rewritten. Source-specific mappings further restrict this alphabet."
    },
    "github_node_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_=-]*$",
      "description": "GitHub GraphQL node_id. Every GitHub-sourced structural ID uses this adapter mapping before schema validation."
    },
    "numeric_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "description": "Base-10 database ID without leading zeroes, used by GitLab, Forgejo, and Jira record IDs."
    },
    "canonical_entity_id": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^fullsend:entity:v1:(github|gitlab|forgejo|jira):[a-z0-9.-]+(%3A[1-9][0-9]{0,4})?:(work_item|change_proposal|conversation):([A-Za-z0-9._~-]|%[0-9A-F]{2})+$",
      "description": "Canonical fullsend entity ID computed by the Normalized entity v1 rule from source.system, source.host, kind, and source_id. Forgejo IDs use the same construction but have no Normalized entity v1 counterpart."
    },
    "entity_kind": {
      "enum": ["work_item", "change_proposal", "conversation"]
    },
    "source_system": {
      "enum": ["github", "gitlab", "forgejo", "jira"]
    },
    "finding_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/~!$&()+,;=:@#\\[\\]{} -]+$",
      "allOf": [
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "/$" } },
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "(^|/)\\.{1,2}(/|$)" } },
        { "not": { "pattern": "%" } },
        { "not": { "pattern": "[\u200b-\u200d\u202a-\u202e\u2066-\u2069\ufeff\ufe00-\ufe0f\ufff9-\ufffb]" } }
      ]
    },
    "actor_role": {
      "enum": ["admin", "maintain", "write", "triage", "read", "none", "external"]
    },
    "actor_ref": {
      "type": "object",
      "required": ["id", "login"],
      "properties": {
        "id": {
          "oneOf": [
            { "$ref": "#/$defs/structural_id" },
            { "type": "null" }
          ],
          "description": "Immutable source actor ID, or null when the source withholds or has deleted the actor. Kind and role are in state/actors.json."
        },
        "login": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Filtered current display login; untrusted and mutable."
        }
      },
      "additionalProperties": false,
      "description": "Identity subset of the Normalized entity v1 actor shape. Mutable kind, role, role_verified, and bot_role values are staged separately in state/actors.json."
    },
    "scope": {
      "enum": ["entity", "labels", "comments", "threads", "reviews", "checks", "check_logs", "agent_runs", "actors"]
    },
    "source": {
      "type": "object",
      "required": ["system", "host"],
      "properties": {
        "system": { "$ref": "#/$defs/source_system" },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(:([1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$",
          "allOf": [{ "not": { "pattern": ":443$" } }]
        },
        "repository_id": { "$ref": "#/$defs/structural_id" },
        "repository": {
          "allOf": [
            { "$ref": "#/$defs/repository_path" },
            { "pattern": "^[^/]+(/[^/]+)+$" }
          ]
        },
        "project": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "description": "Jira project key; a mutable navigation value."
        },
        "project_id": {
          "$ref": "#/$defs/numeric_id",
          "description": "Immutable Jira project database ID."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "system": { "const": "jira" } }, "required": ["system"] },
          "then": {
            "required": ["project", "project_id"],
            "not": { "anyOf": [{ "required": ["repository"] }, { "required": ["repository_id"] }] }
          },
          "else": {
            "required": ["repository", "repository_id"],
            "not": { "anyOf": [{ "required": ["project"] }, { "required": ["project_id"] }] }
          }
        },
        {
          "if": { "properties": { "system": { "const": "github" } }, "required": ["system"] },
          "then": {
            "properties": {
              "repository_id": { "$ref": "#/$defs/github_node_id" },
              "repository": { "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$" }
            }
          }
        },
        {
          "if": { "properties": { "system": { "enum": ["gitlab", "forgejo"] } }, "required": ["system"] },
          "then": { "properties": { "repository_id": { "$ref": "#/$defs/numeric_id" } } }
        },
        {
          "if": { "properties": { "system": { "const": "forgejo" } }, "required": ["system"] },
          "then": { "properties": { "repository": { "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$" } } }
        }
      ],
      "additionalProperties": false,
      "description": "Same field names and meanings as Normalized entity v1 entity.source, extended with the snapshot-only forgejo system."
    },
    "entity_identity_rules": {
      "description": "Provider/kind and source_id constraints shared by index.json entity and entity/metadata.json. The containing schema declares the properties.",
      "required": ["kind", "id", "source_id", "source"],
      "properties": {
        "kind": { "$ref": "#/$defs/entity_kind" },
        "id": { "$ref": "#/$defs/canonical_entity_id" },
        "source_id": { "$ref": "#/$defs/structural_id" },
        "source": { "$ref": "#/$defs/source" }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "properties": { "system": { "const": "github" } }, "required": ["system"] } }, "required": ["source"] },
          "then": { "properties": { "source_id": { "$ref": "#/$defs/github_node_id" } } },
          "else": { "properties": { "source_id": { "$ref": "#/$defs/numeric_id" } } }
        },
        {
          "if": { "properties": { "source": { "properties": { "system": { "const": "jira" } }, "required": ["system"] } }, "required": ["source"] },
          "then": { "properties": { "kind": { "const": "work_item" } } }
        },
        {
          "if": { "properties": { "source": { "properties": { "system": { "enum": ["gitlab", "forgejo"] } }, "required": ["system"] } }, "required": ["source"] },
          "then": { "properties": { "kind": { "enum": ["work_item", "change_proposal"] } } }
        }
      ]
    }
  }
}
