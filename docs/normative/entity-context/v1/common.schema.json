{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullsend.ai/normative/entity-context/v1/common.schema.json",
  "title": "EntityContextCommonDefinitions",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{9}Z$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "record_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*[/]$)(?!.*(^|/)[.]{1,2}(/|$))(?!.*%(?:2[EeFf]|5[Cc]))(?!.*[\u200b-\u200d\u202a-\u202e\u2066-\u2069\ufeff\ufe00-\ufe0f\ufff9-\ufffb\udb40\udc00-\udb40\udc7f\udb40\udd00-\udb40\uddef])[A-Za-z0-9._/~!$&()+,;=:@%#\\[\\]{} -]+$"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[a-z0-9.-]+(?::(?!443(?:/|$))(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[A-Za-z0-9._~!$&()*+,;=:@%/?#-]*)?$"
    },
    "actor_role": {
      "enum": ["admin", "maintain", "write", "triage", "read", "none", "external"]
    }
  }
}
