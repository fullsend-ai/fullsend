{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullsend.ai/normative/entity-context/v1/check.schema.json",
  "title": "CheckMetadata",
  "type": "object",
  "required": ["id", "name", "status", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["queued", "in_progress", "completed"] },
    "conclusion": { "enum": ["success", "failure", "neutral", "cancelled", "skipped", "timed_out", "action_required", "stale"] },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "started_at": {
      "$ref": "common.schema.json#/$defs/timestamp",
      "description": "Required for in-progress checks and completed checks that the forge reports as having started. A completed failure may omit it only when the native forge outcome explicitly says the job never started, such as GitHub startup_failure."
    },
    "completed_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "queued" } }, "required": ["status"] },
      "then": { "not": { "anyOf": [{ "required": ["started_at"] }, { "required": ["completed_at"] }, { "required": ["conclusion"] }] } }
    },
    {
      "if": { "properties": { "status": { "const": "in_progress" } }, "required": ["status"] },
      "then": {
        "required": ["started_at"],
        "not": { "anyOf": [{ "required": ["completed_at"] }, { "required": ["conclusion"] }] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": {
        "required": ["completed_at", "conclusion"],
        "if": { "properties": { "conclusion": { "enum": ["cancelled", "skipped", "failure"] } }, "required": ["conclusion"] },
        "else": { "required": ["started_at"] }
      }
    }
  ],
  "additionalProperties": false
}
